// Copy this file outside the repository or to a site-specific untracked path,
// replace the example values, and load it with `-c` after `-profile slurm`.
//
// Example:
// nextflow run . -profile slurm -c /path/to/my-site.config \
//   --assembly /shared/data/genome.fasta

process {
    queue = 'your-partition'
    clusterOptions = '--account=your-project-account'
    time = '24h'
    memory = '16 GB'
}
